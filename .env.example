# Alle waarden zijn optioneel; dit zijn de standaardinstellingen.
PORT=8080
LOG_LEVEL=INFO
DATA_DIR=/app/data

# Nederlandse bron
NL_GPX_URL=https://drinkwaterpunten.nl/assets/gpx/publieke_drinkwaterpunten_nl.gpx
NL_CACHE_TTL_SECONDS=86400

# OpenStreetMap
OVERPASS_URL=https://overpass-api.de/api/interpreter,https://overpass.private.coffee/api/interpreter
OVERPASS_TIMEOUT=60

# Verwerking
DEFAULT_RADIUS_M=250
DEDUPE_DISTANCE_M=50
NL_SHARE_THRESHOLD=0.8
GAP_WARNING_KM=40
MAX_UPLOAD_MB=25
JOB_TTL_SECONDS=21600

# Waypoints
WAYPOINT_PREFIX=💧 Water
WAYPOINT_WITH_KM=true
WAYPOINT_SYM=Water Source
WAYPOINT_TYPE=Water

# Wegwerkzaamheden (NDW/Melvin planningsfeed, alleen Nederland)
ROADWORKS_ENABLED=true
ROADWORKS_LINE_TOLERANCE_M=25
ROADWORKS_RADIUS_M=100
ROADWORKS_CACHE_TTL_SECONDS=86400
ROADWORKS_MERGE_GAP_M=250
# Caches op de achtergrond vers houden (controle elk uur)
BACKGROUND_REFRESH=true
# Controle op verboden paden (eigen OSM-wegenkaart, ~450 MB, bouwen piekt op ~2,5 GB RAM)
LEGALITY_ENABLED=true
OSM_MAX_AGE_DAYS=30
OSM_MIN_FREE_MB=2800

# Strava (optioneel)
# auto  = aan zodra client id en secret zijn ingevuld
# false = module volledig uit (publieke installatie zonder Strava)
# true  = geforceerd aan
STRAVA_ENABLED=auto
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REDIRECT_URI=http://server-ip:8080/strava/callback
STRAVA_SCOPE=read,read_all
STRAVA_MAX_ROUTES=100

# Optie B: bestaand token hergebruiken (dan is STRAVA_REDIRECT_URI niet nodig)
STRAVA_ACCESS_TOKEN=
STRAVA_REFRESH_TOKEN=

# Sessies en tokenversleuteling (leeg = sleutel wordt gegenereerd in ./data/secret.key)
SECRET_KEY=
COOKIE_SECURE=false
SESSION_TTL_SECONDS=2592000

# Routeboek.cc (optioneel): routes van een clubpagina scrapen, geen API nodig.
ROUTEBOEK_ENABLED=true
ROUTEBOEK_BASE_URL=https://routeboek.cc
ROUTEBOEK_CLUB_SLUG=stampers
ROUTEBOEK_CACHE_TTL_SECONDS=900
